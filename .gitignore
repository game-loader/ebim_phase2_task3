# Runtime output. Never commit robot data, logs or checkpoints.
outputs/
log/
*.log
*.jsonl

# Python and tooling
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
build/
dist/

# colcon build products. The site ROS 2 packages are built on the robot host.
site/build/
site/install/
site/log/

# Base-host runtime state; only the route code is versioned.
base/tmr_cycle/logs/
base/tmr_cycle/state/
base/tmr_cycle/outputs/
base/tmr_cycle/backups/
base/tmr_cycle/maps/
base/tmr_navigation/install/
base/tmr_navigation/build/
base/tmr_navigation/log/

# Local configuration and editors
.env
.env.*
.idea/
.vscode/
*.swp
*~
.DS_Store
.claude/

# Ultralytics runtime state
.ultralytics/
