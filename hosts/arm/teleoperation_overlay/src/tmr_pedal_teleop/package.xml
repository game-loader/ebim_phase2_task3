<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tmr_pedal_teleop</name>
  <version>0.0.1</version>
  <description>Bridges foot-pedal states (/pedal/state) to the TMR mobile base
    (swerve_drive_controller/cmd_vel) and the Franka spine (MoveAbsolute).</description>
  <maintainer email="osmallfrogo.hchs@gmail.com">demo</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>franka_spine_msgs</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
